<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js" defer></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        * { margin:0; padding:0; box-sizing:border-box; }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: #fff7ed;
            min-height: 100vh;
        }

        .profile-container { width: 100%; margin: 44px auto; padding: 0 40px; }
        .page-title { font-size: 32px; font-weight: 800; color: #7c2d12; margin-bottom: 32px; letter-spacing: -1px; }
        .card { background: #ffffff; padding: 36px; border-radius: 20px; box-shadow: 0 4px 20px rgba(234,88,12,0.10); margin-bottom: 28px; border: 2px solid #fed7aa; }
        .card-title { font-size: 20px; font-weight: 800; color: #7c2d12; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 2px solid #ffedd5; }
        .profile-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-bottom: 22px; }
        .profile-item { background: linear-gradient(135deg,#fff7ed,#ffedd5); padding: 20px; border-radius: 12px; border-left: 5px solid #f97316; }
        .profile-label { color: #78350f; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; margin-bottom: 6px; }
        .profile-value { color: #1c0a00; font-size: 16px; font-weight: 700; }
        .form-group { margin-bottom: 20px; }
        .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
        label { display: block; margin-bottom: 8px; color: #7c2d12; font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
        input, textarea, select { width: 100%; padding: 13px 16px; border: 2px solid #fed7aa; border-radius: 10px; font-size: 14px; font-family: inherit; background: #fff7ed; color: #1c0a00; transition: 0.2s; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: #f97316; background: #fff; box-shadow: 0 0 0 4px rgba(249,115,22,0.12); }
        textarea { resize: vertical; min-height: 90px; }
        .btn-container { display: flex; gap: 12px; justify-content: flex-end; margin-top: 28px; padding-top: 22px; border-top: 2px solid #ffedd5; flex-wrap: wrap; }
        .btn { padding: 13px 28px; border: none; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.25s; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .btn-edit { background: linear-gradient(135deg,#f97316,#ea580c); color: #fff; box-shadow: 0 4px 14px rgba(249,115,22,0.4); }
        .btn-edit:hover { background: linear-gradient(135deg,#ea580c,#c2410c); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(249,115,22,0.5); }
        .btn-save { background: linear-gradient(135deg,#22c55e,#16a34a); color: #fff; box-shadow: 0 4px 14px rgba(34,197,94,0.35); }
        .btn-save:hover { background: linear-gradient(135deg,#16a34a,#15803d); transform: translateY(-2px); }
        .btn-cancel { background: #f3f4f6; color: #4b5563; border: 2px solid #e5e7eb; box-shadow: none; }
        .btn-cancel:hover { background: #e5e7eb; transform: translateY(-1px); }
        @media (max-width: 768px) {
            .profile-grid, .form-row { grid-template-columns: 1fr; }
            .btn-container { flex-direction: column; }
            .btn { width: 100%; justify-content: center; }
            .page-title { font-size: 24px; }
            .profile-container { padding: 0 16px; }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="nav-links" id="nav-links-list">
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/3">Applications</a></li>
                <li><a href="/savedJobs">Saved Jobs</a></li>
                <li><a href="/">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- Container -->
    <div class="profile-container">
        <div class="page-title">👤 My Profile</div>

        <!-- Personal Information Card -->
        <div class="card">
            <div class="card-title">📋 Personal Information</div>

            <div class="profile-grid">
                <div class="profile-item">
                    <div class="profile-label">👤 Full Name</div>
                    <div class="profile-value"><%= candidate.name||'Not'%></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📧 Email</div>
                    <div class="profile-value"><%= candidate.email||'Not' %></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📞 Phone</div>
                    <div class="profile-value"><%= candidate.phone || 'Not added' %></div>
                </div>

                <div class="profile-item">
                    <div class="profile-label">📍 Location</div>
                    <div class="profile-value"><%= candidate.location || 'Not added' %></div>
                </div>
            </div>

            <div class="btn-container">
                <button id="editPersonalBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Personal Info Modal -->
        <div id="editPersonalModal" style="display:none;" class="card">
            <div class="card-title">✏️ Edit Personal Information</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" value="<%=candidate.name||'not' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" value="<%=candidate.phone || '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" placeholder="City, Country" value="<%= candidate.location || '' %>">
                </div>

                <div class="btn-container">
                    <button type="button" id="closePersonalBtn" class="btn btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Skills Card -->
        <div class="card">
            <div class="card-title">💼 Skills</div>

            <div class="profile-item">
                <div class="profile-label">Your Skills</div>
                <div class="profile-value"><%= candidate.skills || 'Not added' %></div>
            </div>

            <div class="btn-container">
                <button id="editSkillsBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Skills Modal -->
        <div id="editSkillsModal" style="display:none;" class="card">
            <div class="card-title">✏️ Edit Skills</div>

            <form method="POST" action="/candidate/update">
                <div class="form-group">
                    <label for="skills">Add Your Skills</label>
                    <textarea id="skills" name="skills" placeholder="JavaScript, React, Node.js, MongoDB..."><%= candidate.skills || '' %></textarea>
                    <small style="color: #7f8c8d;">Separate skills with commas</small>
                </div>

                <div class="btn-container">
                    <button type="button" id="closeSkillsBtn" class="btn btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Education Card -->
        <div class="card">
            <div class="card-title">🎓 Education</div>

            <div class="profile-item">
                <div class="profile-label">Your Education</div>
                <div class="profile-value"><%= candidate.degree || 'Not added' %></div>
            </div>

            <div class="btn-container">
               <button id="editEducationBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Education Modal -->
        <div id="editEducationModal" style="display:none;" class="card">
            <div class="card-title">✏️ Edit Education</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="degree">Degree</label>
                        <input type="text" id="degree" name="degree" placeholder="B.Tech Computer Science" value="<%= candidate.degree || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="university">University/College</label>
                        <input type="text" id="university" name="university" placeholder="MIT" value="<%= candidate.university || '' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="gradYear">Graduation Year</label>
                        <input type="number" id="gradYear" name="gradYear" placeholder="2023" value="<%= candidate.gradYear || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="field">Field of Study</label>
                        <input type="text" id="field" name="field" placeholder="Computer Science" value="<%= candidate.field || '' %>">
                    </div>
                </div>

                <div class="btn-container">
                   <button type="button" id="closeEducationBtn" class="btn btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>

        <!-- Experience Card -->
        <div class="card">
            <div class="card-title">📈 Experience</div>

            <div class="profile-item">
                <div class="profile-label">Your Experience</div>
                <div class="profile-value"><%= candidate.jobTitle || 'Not added' %></div>
            </div>

            <div class="btn-container">
                <button id="editExperienceBtn" class="btn btn-edit">✏️ Edit</button>
            </div>
        </div>

        <!-- Edit Experience Modal -->
        <div id="editExperienceModal" style="display:none;" class="card">
            <div class="card-title">✏️ Edit Experience</div>

            <form method="POST" action="/candidate/update">
                <div class="form-row">
                    <div class="form-group">
                        <label for="jobTitle">Job Title</label>
                        <input type="text" id="jobTitle" name="jobTitle" placeholder="Senior Developer" value="<%= candidate.jobTitle || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="company">Company</label>
                        <input type="text" id="company" name="company" placeholder="Tech Corp" value="<%= candidate.company || '' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" name="startDate" value="<%= candidate.startDate || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" name="endDate" value="<%= candidate.endDate || '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="expDescription">Description</label>
                    <textarea id="expDescription" name="expDescription" placeholder="Describe your role and achievements..."><%= candidate.expDescription || '' %></textarea>
                </div>

                <div class="btn-container">
                    <button type="button" id="closeExperienceBtn" class="btn btn-cancel">Cancel</button>
                    <button type="submit" class="btn btn-save">💾 Save</button>
                </div>
            </form>
        </div>
    </div>
    <script src="/js/profile.js"></script>
    <script src="/js/toast.js"></script>

