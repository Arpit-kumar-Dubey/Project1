<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Dashboard - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <%- include('partials/dashboard_style') %>
    <script src="/js/toast.js" defer></script>
</head>
<body>
    <!-- Dashboard Navbar -->
    <nav class="dashboard-navbar">
        <div class="navbar-header">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>

            <ul class="navbar-menu" id="dashboard-nav-menu">
                <li class="nav-item">
                    <a href="/Rdashboard" class="nav-link active">
                        <span>📊</span> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/post-job" class="nav-link">
                        <span>➕</span> Post Job
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-posted-jobs" class="nav-link">
                        <span>📋</span> My Jobs
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/recruiter/view-applicants" class="nav-link">
                        <span>👥</span> Applicants
                    </a>
                </li>
            </ul>

            <div class="user-menu">
                <div class="user-info">
                    <div class="user-avatar">👤</div>
                    <span><%=name%></span>
                </div>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="dashboard-container">

        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>Welcome back, <%=name%>! 👋</h1>
            <p>Manage your job postings, review applicants, and find the perfect candidates for your company.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card posted">
                <span class="stat-card-icon">📢</span>
                <div class="stat-card-value"><%=posted%></div>
                <div class="stat-card-label">Jobs Posted</div>
            </div>
            <div class="stat-card applicants">
                <span class="stat-card-icon">👥</span>
                <div class="stat-card-value"><%=Applicants%></div>
                <div class="stat-card-label">Total Applicants</div>
            </div>
        </div>

        <!-- Posted Jobs Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📋 Your Job Postings</h2>
                <div class="header-actions">
                    <a href="/recruiter/post-job" class="post-job-btn">➕ Post New Job</a>
                </div>
            </div>

            <% if (job && job.length > 0) { %>
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Location</th>
                        <th>Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <%job.forEach(job=>{%>
                    <tr>
                        <td class="job-title-cell"><%=job.title%></td>
                        <td><%=job.location%></td>
                        <td><%=job.salary%></td>
                        <td>
                            <a href="/viewpostedJob/<%=job._id%>" class="action-btn view-btn">👁 View</a>
                            <a href="/EditPostedJob/<%=job._id%>" class="action-btn edit-btn">✏️ Edit</a>
                            <a href="/deletePosted/<%=job._id%>" class="action-btn delete-btn" onclick="return confirm('Delete this job?')">🗑 Delete</a>
                        </td>
                    </tr>
                    <%})%>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">📋</div>
                <div class="empty-state-title">No Jobs Posted Yet</div>
                <div class="empty-state-text">Start by posting your first job opportunity!<br><a href="/recruiter/post-job" style="color:#f97316;font-weight:700;">Post a Job →</a></div>
            </div>
            <% } %>
        </div>

        <!-- Recent Applicants Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>👥 Recent Applicants</h2>
                <a href="/recruiter/view-applicants" class="post-job-btn">View All →</a>
            </div>
            <% if (user1 && user1.length > 0) { %>
            <div class="applicants-grid">
                <%user1.forEach(user=>{%>
                <div class="applicant-card">
                    <div class="applicant-header">
                        <div class="applicant-avatar">👨</div>
                        <div class="applicant-info">
                            <h4><%=user.name%></h4>
                            <p class="applicant-email"><%=user.candidate%></p>
                        </div>
                    </div>
                    <div class="applicant-job">
                        <div class="applicant-job-title"><%=user.title%></div>
                        <div class="applicant-job-date">📍 <%=user.locationCandidate%></div>
                        <div class="applicant-job-date">
                            <span class="status-badge <% if(user.status==='Accepted'){%>status-approved<%}else if(user.status==='Rejected'){%>status-rejected<%}else{%>status-pending<%}%>">
                                <%=user.status%>
                            </span>
                        </div>
                    </div>
                    <div class="applicant-actions">
                        <a href="/Accept/<%=user._id%>" class="accept-btn">✅ Accept</a>
                        <a href="/Reject/<%=user._id%>" class="reject-btn">❌ Reject</a>
                    </div>
                </div>
                <%})%>
            </div>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">😕</div>
                <div class="empty-state-title">No Applicants Yet</div>
                <div class="empty-state-text">Applicants will appear here once candidates apply to your jobs.</div>
            </div>
            <% } %>
        </div>
    </div>

<%- include('partials/footer') %>
</body>
</html>
