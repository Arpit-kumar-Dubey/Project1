<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Dashboard - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <%- include('partials/dashboard_style') %>
    <script src="/js/toast.js" defer></script>
</head>
<body>
    <!-- Dashboard Navbar -->
    <nav class="dashboard-navbar">
        <div class="navbar-header">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>

            <ul class="navbar-menu" id="dashboard-nav-menu">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link active">
                        <span>📊</span> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/3" class="nav-link">
                        <span>📝</span> My Applications
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/savedJobs" class="nav-link">
                        <span>❤️</span> Saved Jobs
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/candidate/profile" class="nav-link">
                        <span>👤</span> Profile
                    </a>
                </li>
            </ul>

            <div class="user-menu">
                <div class="user-info">
                    <div class="user-avatar">👤</div>
                    <span><%=name%></span>
                </div>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <div class="dashboard-container">

        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>Welcome back, <%=name%> 👋</h1>
            <p>Let's find you the perfect opportunity. Check out the latest jobs and manage your applications.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card applied">
                <span class="stat-card-icon">📋</span>
                <div class="stat-card-value"><%=applyed%></div>
                <div class="stat-card-label">Applications Sent</div>
            </div>
            <div class="stat-card saved">
                <span class="stat-card-icon">❤️</span>
                <div class="stat-card-value"><%=save%></div>
                <div class="stat-card-label">Jobs Saved</div>
            </div>
        </div>

        <!-- Featured Jobs Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📌 Featured Job Opportunities</h2>
                <div class="search-filter">
                    <form action="/filter" method="post" style="display:flex;gap:12px;flex-wrap:wrap;">
                        <input type="text" class="search-input" placeholder="Search jobs by title..." name="title">
                        <button type="submit" class="filter-btn" style="width:auto;">🔍 Filter</button>
                    </form>
                </div>
            </div>

            <% if (jobs && jobs.length > 0) { %>
                <div class="job-cards-grid">
                    <% jobs.forEach(job => { %>
                        <div class="job-card">
                            <div class="job-card-header">
                                <div>
                                    <div class="job-title"><%= job.title %></div>
                                    <div class="job-company">🏢 <%= job.company %></div>
                                </div>
                                <span style="font-size:24px;">⭐</span>
                            </div>
                            <div class="job-location">📍 <%= job.location %></div>
                            <div class="job-salary">💰 <%= job.salary %></div>
                            <div class="job-description" style="margin-bottom:8px;color:#78350f;font-size:14px;line-height:1.6;">
                                <%= job.description.substring(0, 100) %>...
                            </div>
                            <div class="job-card-footer">
                                <div class="job-posted-date" style="font-size:12px;">📅 Posted <%= job.postedDate %></div>
                                <div class="job-card-actions" style="display:flex;gap:10px;">
                                    <a href="/applyforjob/<%=job._id%>" class="job-action-btn apply-btn">🚀 Apply</a>
                                    <a href="/saveJob/<%=job._id%>" class="job-action-btn save-btn">❤️ Save</a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">😕</div>
                    <div class="empty-state-title">No Jobs Found</div>
                    <div class="empty-state-text">No job listings available at the moment. Check back soon!</div>
                </div>
            <% } %>
        </div>

        <!-- Recent Applications Section -->
        <div class="dashboard-content">
            <div class="content-header">
                <h2>📊 Recent Applications</h2>
                <a href="/3" class="post-job-btn">View All →</a>
            </div>

            <% if (apply && apply.length > 0) { %>
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Company</th>
                        <th>Applied Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <%apply.forEach(data=>{%>
                    <tr>
                        <td class="job-title-cell"><%=data.title%></td>
                        <td><%=data.company%></td>
                        <td><%=data.appliedAt%></td>
                        <td>
                            <span class="status-badge <% if(data.status==='Accepted'){%>status-approved<%}else if(data.status==='Rejected'){%>status-rejected<%}else{%>status-pending<%}%>">
                                <%=data.status%>
                            </span>
                        </td>
                    </tr>
                    <%})%>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state" style="padding:48px 24px;">
                <div class="empty-state-icon">📝</div>
                <div class="empty-state-title">No Applications Yet</div>
                <div class="empty-state-text">Start applying to jobs and track your applications here.</div>
            </div>
            <% } %>
        </div>
    </div>

<%- include('partials/footer') %>
</body>
</html>
