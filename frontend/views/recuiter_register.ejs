<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Register - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js" defer></script>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="nav-links" id="nav-links-list">
                <li><a href="/recruiter/register">Recruiter Register</a></li>
                <li><a href="/candidate/register">Candidate Register</a></li>
                <li><a href="/">Home</a></li>
            </ul>
        </div>
    </nav>

    <div class="container" style="max-width: 860px;">
        <div class="page-header">
            <h1>👔 Register as Recruiter</h1>
            <p>Create your recruiter account to post job opportunities</p>
        </div>

        <div class="form-container">
            <form method="POST" action="/recruiter/register1">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter your full name" required>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email address" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Create a strong password" required>
                </div>

                <button type="submit">✅ Register Now</button>
            </form>

            <div class="link-section">
                <p>Already have an account? <a href="/recruiter/login">Login here</a></p>
                <p style="margin-top:8px;">Are you a candidate? <a href="/candidate/register">Register as Candidate</a></p>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>
</body>
</html>
