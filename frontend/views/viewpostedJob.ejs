<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Details - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js" defer></script>
    <style>
        .job-detail-card {
            background: #ffffff;
            padding: 52px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(234,88,12,0.12);
            border: 2px solid #fed7aa;
            margin-top: 0;
        }
        .job-detail-title { font-size: 36px; font-weight: 800; color: #7c2d12; margin-bottom: 8px; letter-spacing: -1px; }
        .job-detail-company { font-size: 18px; color: #f97316; font-weight: 700; margin-bottom: 36px; }
        .detail-boxes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin-bottom: 36px;
        }
        .detail-box {
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            padding: 24px 20px;
            border-radius: 14px;
            border: 2px solid #fed7aa;
            border-left: 5px solid #f97316;
        }
        .detail-box-label { color: #78350f; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; }
        .detail-box-value { color: #1c0a00; font-size: 16px; font-weight: 700; }
        .description-sec { margin-top: 32px; padding-top: 32px; border-top: 2px solid #ffedd5; }
        .description-sec h3 { font-size: 20px; font-weight: 800; color: #7c2d12; margin-bottom: 16px; }
        .description-sec p { color: #78350f; font-size: 15px; line-height: 1.85; }
        .action-buttons { margin-top: 36px; display: flex; gap: 16px; justify-content: flex-end; flex-wrap: wrap; }
        .back-link {
            display: inline-flex; align-items: center; gap: 6px;
            color: #f97316; font-weight: 700; text-decoration: none;
            margin-bottom: 28px; font-size: 14px;
            padding: 8px 16px;
            background: #fff7ed;
            border-radius: 8px;
            border: 1.5px solid #fed7aa;
            transition: all 0.2s;
        }
        .back-link:hover { background: #ffedd5; border-color: #f97316; }
        @media (max-width: 640px) {
            .job-detail-card { padding: 28px 20px; }
            .job-detail-title { font-size: 26px; }
            .action-buttons { flex-direction: column; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">🚀 Job Portal</a>
            <ul class="nav-links" id="nav-links-list">
                <li><a href="/Rdashboard">Dashboard</a></li>
                <li><a href="/recruiter/view-posted-jobs">My Jobs</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <a href="/Rdashboard" class="back-link">← Back to Dashboard</a>

        <div class="job-detail-card">
            <div class="job-detail-title"><%= job.title %></div>
            <div class="job-detail-company">🏢 <%= job.company %></div>

            <div class="detail-boxes">
                <div class="detail-box">
                    <div class="detail-box-label">📍 Location</div>
                    <div class="detail-box-value"><%= job.location %></div>
                </div>
                <div class="detail-box">
                    <div class="detail-box-label">💰 Salary</div>
                    <div class="detail-box-value"><%= job.salary %></div>
                </div>
                <div class="detail-box">
                    <div class="detail-box-label">📅 Posted Date</div>
                    <div class="detail-box-value"><%= job.postedDate %></div>
                </div>
                <div class="detail-box">
                    <div class="detail-box-label">🏢 Company</div>
                    <div class="detail-box-value"><%= job.company %></div>
                </div>
            </div>

            <div class="description-sec">
                <h3>📋 Job Description</h3>
                <p><%= job.description %></p>
            </div>

            <div class="action-buttons">
                <a href="/Rdashboard" class="btn-primary" style="width:auto;">← Back</a>
                <a href="/EditPostedJob/<%= job._id %>" class="btn-secondary" style="width:auto;border:2px solid #f97316;">✏️ Edit Job</a>
                <a href="/deletePosted/<%= job._id %>" class="delete" style="width:auto;display:inline-block;text-decoration:none;padding:14px 24px;border-radius:10px;" onclick="return confirm('Delete this job?')">🗑 Delete</a>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>
</body>
</html>